layout {
    gaps 10
    center-focused-column "on-overflow"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring { off; }
    border {
        on
        width 2
        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    shadow {
        on
        softness 20
        spread 2
        offset x=0 y=4
        color "#00000070"
    }

    struts {
        top 4
        bottom 4
        left 4
        right 4
    }
}
